# Written here by @recursica/official-release's postinstall when you run `npm install`.
# The design tokens belong to the Recursica release, not to this app — vendoring a copy
# means a stale one, and 2.1 MB of generated CSS in every diff.
recursica_variables_scoped.css
recursica_brand.json
recursica_tokens.json
recursica_ui-kit.json
recursica.json
# Which release the five files above came from, so a version bump re-copies them instead of
# leaving the old ones in place. Written by scripts/ensure-tokens.mjs.
.recursica-tokens-version
