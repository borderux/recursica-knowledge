# Copy to stu.env (gitignored) and fill in. start.command sources this; every value can also be
# passed as a flag, and a flag wins. Nothing here is a secret — the key is a separate file — but
# every value names a specific client's data, which is why none of them are committed.

# Channel slug. Lowercase, alphanumeric and hyphens. The BigQuery dataset is derived from it:
# slug "acme" reads research_acme.
STU_SLUG=acme

# Google Cloud project holding that dataset.
# Console → project picker → the project ID, not the display name.
STU_PROJECT=acme-research-123456

# UUID of the Buzz channel this research lives in. Optional, but without it the identity picker
# has no roster to offer and edits cannot be attributed. Open the channel in Buzz; the UUID is
# in the header or the URL.
STU_CHANNEL=00000000-0000-0000-0000-000000000000

# Loopback port. Change it to run two channels side by side.
STU_PORT=4317

# Path to the BigQuery service-account key. Leave unset to use the search order in start.command:
# ./secrets/claire-<slug>-service-user.json, then ~/.buzz/.secrets/claire-<slug>-service-user.json.
#STU_BQ_KEY=
