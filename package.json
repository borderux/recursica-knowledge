{
  "name": "@recursica/knowledge",
  "description": "Recursica design system central knowledge, documentation, and agent instructions",
  "version": "0.7.0",
  "private": false,
  "workspaces": [
    "."
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/borderux/recursica-knowledge#readme",
  "bugs": {
    "url": "https://github.com/borderux/recursica-knowledge/issues"
  },
  "author": "hi@borderux.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borderux/recursica-knowledge.git"
  },
  "files": [
    "skills",
    "docs",
    "n8n",
    "scripts",
    "llms.txt",
    "AGENT.md",
    "README.md",
    "CONTRIBUTING.md",
    "SETUP.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-skills.js",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "node .husky/install.mjs",
    "format": "prettier --write \"**/*.{json,md,yml,yaml}\"",
    "agents:export": "node buzz-agents/scripts/export-agents.mjs",
    "agents:check": "node buzz-agents/scripts/export-agents.mjs --check",
    "agents:restore": "node buzz-agents/scripts/restore-agents.mjs",
    "check:names": "node buzz-agents/scripts/check-text-for-names.mjs",
    "agents:build": "node scripts/build-agents.mjs",
    "agents:build:check": "node scripts/build-agents.mjs --check"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "3.5.3"
  }
}
