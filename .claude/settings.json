{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node buzz-agents/scripts/hook-guard-published-text.mjs",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node buzz-agents/scripts/hook-guard-commit-trailers.mjs",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking the commit for the operator's sign-off"
          },
          {
            "type": "command",
            "command": "node buzz-agents/scripts/hook-guard-published-text.mjs",
            "if": "Bash(gh *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node buzz-agents/scripts/hook-guard-published-text.mjs",
            "if": "Bash(buzz *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node buzz-agents/scripts/hook-guard-published-text.mjs",
            "if": "Bash(curl *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          }
        ]
      }
    ]
  }
}
