<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly backup of the RecursicaChat 2.0 server, as root, at 03:30, after the kit's 02:00 backup.
     The log is in /var/log/recursicachat, which only root can open. No secret is in this file. -->
<plist version="1.0"><dict>
  <key>Label</key><string>io.recursica.recursicachat-backup</string>
  <key>UserName</key><string>root</string>
  <key>WorkingDirectory</key><string>/</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/opt/recursicachat/bin/backup.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>/var/root</string>
  </dict>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>/var/log/recursicachat/backup.log</string>
  <key>StandardErrorPath</key><string>/var/log/recursicachat/backup.log</string>
</dict></plist>
