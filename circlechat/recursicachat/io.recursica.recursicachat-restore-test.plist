<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Monthly test restore of the RecursicaChat 2.0 server's backup, as root, on the 1st at 05:00, after the
     kit's own restore test (04:30). Posts pass or fail to the stack's Slack channel. -->
<plist version="1.0"><dict>
  <key>Label</key><string>io.recursica.recursicachat-restore-test</string>
  <key>UserName</key><string>root</string>
  <key>WorkingDirectory</key><string>/</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/opt/recursicachat/bin/restore-test.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>/var/root</string>
  </dict>
  <key>StartCalendarInterval</key><dict>
    <key>Day</key><integer>1</integer>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/var/log/recursicachat/restore-test.log</string>
  <key>StandardErrorPath</key><string>/var/log/recursicachat/restore-test.log</string>
</dict></plist>
