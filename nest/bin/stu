#!/usr/bin/env bash
# Launch Stu, the local data explorer, for one research channel.
#
#   ~/.buzz/bin/stu --slug acme --channel <channel-uuid>
#   ~/.buzz/bin/stu --slug acme --status
#   ~/.buzz/bin/stu --slug acme --stop
#
# --sa-slug <name>  the service account's name, when it differs from the slug, read as
#   .secrets/claire-<sa-slug>-service-user.json. Rarely needed, for the same reason --dataset is
#   rarely needed: with no flag the launcher takes the key path this channel's MCP servers were
#   registered with, which is the account the agents already query as. Passing it overrides that
#   lookup. Absent both, the path is derived from the slug as it always was.
#
#   The flag exists because a Google service account cannot be renamed, so a slug shortened after
#   the account was created leaves the two apart forever.
#
# --key <path>  the service-account key outright, skipping both the lookup and the derivation.
#   This is what the launchd job carries, so the supervising child is handed the parent's answer
#   rather than re-deriving one from the same inputs.
#
# --dataset <name>  the BigQuery dataset, when it is not named research_<slug>. Rarely needed:
#   with no flag the launcher reads the name out of this channel's fenced MCP server config,
#   which the deploy wrote from the same value the dataset was created with. Only a channel with
#   no such server on this machine falls back to the research_<slug> derivation.
#
#   Naming it by hand was the whole failure mode. An overridden dataset that reached the deploy
#   and not this launcher left every query failing with "Access Denied ... or perhaps it does not
#   exist" — which reads as a broken grant and is not one: it is a name nobody created. That
#   wording is BigQuery declining to distinguish a table you may not see from a table that is not
#   there, so the diagnosis went to IAM every time and the dataset never got looked at.
#
# Idempotent: if a server is already serving this slug on the port, it prints that URL and
# exits 0 rather than binding a second one. That matters because Stu has two launch paths —
# Claire finishing a transcript, and a person saying "@Stu open the explorer" — and they will
# collide.
#
# Lifetime: the server runs under launchd as a per-slug user agent, never as a child of the shell
# that launched it. That is the whole point. An agent's tool call kills its entire process group
# when it returns, so a plain `node ... &` came up, printed its URL, and was reaped a second later
# every time an agent started it — it only ever survived when a human ran it from a terminal.
# launchd owns the process instead, so it outlives the launching shell and stops only when
# `--stop` runs or Buzz Desktop quits. If node itself crashes, launchd restarts it.
#
# Who is editing: pass --user <pubkey> (with --user-name / --user-email) and the app shows that
# person for confirmation instead of trying to look up the channel roster. The roster lookup
# needs a relay credential, which a launchd job does not have — see server/identity.mjs.
#
# Exit codes: 0 running (started, already up, or stopped), 1 usage/preflight, 2 build or start failed.

set -euo pipefail

BUZZ_HOME="${BUZZ_HOME:-$HOME/.buzz}"
# The app is source, not configuration, so it is not copied into the nest — it is read
# out of the checkout, at the path bootstrap-nest.mjs baked in when it installed this
# script. STU_APP overrides it, which is how you point at a second checkout. Earlier
# revisions hardcoded $BUZZ_HOME/REPOS/stu-explorer: no fresh install ever created it, so
# every one of those got "Stu is not installed" from a correctly installed Stu.
#
# On the machine the app was first written on, that directory does exist — the pre-move
# working copy, superseded 2026-08-05, no .git, nothing newer than 2026-08-04 in it. Do
# not read source from it: two agents cited its line numbers as the running app in one
# week, and one of them read past `fatal: not a git repository` to do it. The line below
# is the only path that runs; guard-stale-checkout.mjs now denies reads of the other.
APP="${STU_APP:-{{STU_APP}}}"
RUN_DIR="$BUZZ_HOME/run"
SLUG=""
# The service account is usually named after the slug, but it need not be: a Google service
# account cannot be renamed after creation, so a client whose slug is later shortened keeps
# the original name forever. --sa-slug names the key independently of the channel.
SA_SLUG="${STU_SA_SLUG:-}"
KEY_ARG=""
CHANNEL=""
PROJECT="${STU_PROJECT:-}"
# Empty here means "work it out in the preflight" — from the channel's MCP config if there is one,
# and otherwise by letting the app derive research_<slug>. A dataset that already existed under a
# name somebody else chose cannot be renamed in BigQuery, so the name has to be sayable here as
# well as at deploy time; it just should not have to be said.
DATASET="${STU_DATASET:-}"
USER_PUBKEY="${STU_USER_PUBKEY:-}"
USER_NAME="${STU_USER_NAME:-}"
USER_EMAIL="${STU_USER_EMAIL:-}"
PORT="${STU_PORT:-4317}"
ACTION="start"

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --slug)       SLUG="$2"; shift 2 ;;
    --sa-slug)    SA_SLUG="$2"; shift 2 ;;
    # The key path outright, skipping both the registry lookup and the slug derivation. This is
    # what the launchd plist carries, so the supervising child is handed the parent's answer
    # instead of re-deriving one; it is equally usable by hand.
    --key)        KEY_ARG="$2"; shift 2 ;;
    --channel)    CHANNEL="$2"; shift 2 ;;
    --project)    PROJECT="$2"; shift 2 ;;
    --dataset)    DATASET="$2"; shift 2 ;;
    --user)       USER_PUBKEY="$2"; shift 2 ;;
    --user-name)  USER_NAME="$2"; shift 2 ;;
    --user-email) USER_EMAIL="$2"; shift 2 ;;
    --port)       PORT="$2"; shift 2 ;;
    --foreground) ACTION="foreground"; shift ;;
    --stop)       ACTION="stop"; shift ;;
    --status)     ACTION="status"; shift ;;
    # Internal: launchd's entry point. Runs node in the foreground and watches Buzz Desktop.
    --supervise)  ACTION="supervise"; shift ;;
    # The header block above: every comment line from the second to the exit-codes line that ends
    # it. This used to be a hardcoded `sed -n '2,35p'`, which silently truncates the help the first
    # time anybody adds a paragraph up there. Writing this change did it twice — once by extending
    # the header, then again after correcting the number and extending the header further. A bound
    # that has to be re-counted by hand will be got wrong by hand, so there is no number left.
    -h|--help)
      awk 'NR == 1 { next }
           /^#/ { sub(/^# ?/, ""); print; if (/^Exit codes/) exit; next }
           { exit }' "$0"
      exit 0 ;;
    *) echo "stu: unknown argument $1" >&2; exit 1 ;;
  esac
done

# $1, not $*: the second argument is the exit code, and $* printed it as part of the message. Every
# multi-line die here ended in a stray " 2" that reads like the message ran into something.
die() { echo "stu: $1" >&2; exit "${2:-1}"; }

[[ -n "$SLUG" ]] || die "--slug is required (e.g. --slug acme)"
# Same rule config.mjs enforces, and it also keeps the slug safe in a launchd label and filename.
[[ "$SLUG" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "--slug must be lowercase alphanumeric with hyphens: got \"$SLUG\""
# Whether anybody actually named an account, captured before the default lands on top of it. An
# explicit --sa-slug is an operator overriding the recorded key path on purpose, so the preflight
# skips the registry lookup entirely rather than second-guessing them.
SA_SLUG_GIVEN="$SA_SLUG"
# Defaults to the slug, which is the common case. Same character rule: Google service account
# ids allow hyphens and not underscores, so an underscore here can never match a real account.
SA_SLUG="${SA_SLUG:-$SLUG}"
[[ "$SA_SLUG" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "--sa-slug must be lowercase alphanumeric with hyphens: got \"$SA_SLUG\""
# BigQuery's own charset for a dataset name, checked here for the same reason the deploy checks its
# copy of this flag: the value is rejected before a launchd job is written rather than after one is
# loaded and answering on a name that cannot resolve. Case is significant to BigQuery, so it is
# preserved rather than folded. The empty default is left alone — the app does the deriving.
[[ -z "$DATASET" || "$DATASET" =~ ^[A-Za-z0-9_]+$ ]] \
  || die "--dataset must be letters, digits and underscores only: got \"$DATASET\""

URL="http://127.0.0.1:$PORT"
LABEL="com.buzz.stu.$SLUG"
DOMAIN="gui/$(id -u)"
# Deliberately not ~/Library/LaunchAgents: plists there are loaded at every login, and a research
# explorer that silently comes back after a reboot is worse than one you have to start.
PLIST="$RUN_DIR/$LABEL.plist"
LOG="$RUN_DIR/stu-$SLUG.log"

# Is something already serving this slug here? Only a *matching* slug counts as reuse; another
# channel on this port is a conflict.
serving_this_slug() {
  local body
  body="$(curl -fsS --max-time 2 "$URL/api/config" 2>/dev/null)" || return 1
  grep -q "\"slug\":\"$SLUG\"" <<<"$body"
}

# ...and serving it out of the dataset this launch resolved. The slug alone used to decide reuse,
# which turned the fix for a forgotten --dataset into a no-op: the launcher found its own
# wrong-dataset job, printed "already running" and exited 0, so the only way through was to know
# to --stop first. Now that the preflight resolves the name rather than waiting to be told it,
# this check has a value to compare in every case that has an MCP server — so a job left over
# from before, serving the derived name, is reported instead of reused.
serving_this_dataset() {
  if [[ -z "$DATASET" ]]; then return 0; fi
  local body
  body="$(curl -fsS --max-time 2 "$URL/api/config" 2>/dev/null)" || return 1
  grep -q "\"dataset\":\"[^\"]*\.$DATASET\"" <<<"$body"
}

# Empty when Buzz Desktop is not running. buzz-acp helpers come and go per session, so anchor on
# the one process whose lifetime *is* the app.
buzz_desktop_pid() {
  pgrep -f '/Buzz\.app/Contents/MacOS/buzz-desktop' 2>/dev/null | head -1 || true
}

job_pid() {
  launchctl print "$DOMAIN/$LABEL" 2>/dev/null \
    | awk '/^[[:space:]]*pid = /{print $3; exit}' || true
}

# -------------------------------------------------------------------- stop / status

if [[ "$ACTION" == "stop" ]]; then
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
  rm -f "$PLIST"
  for _ in $(seq 1 10); do
    curl -fsS --max-time 2 "$URL/api/config" >/dev/null 2>&1 || { echo "stu: $SLUG stopped"; exit 0; }
    sleep 1
  done
  die "asked launchd to stop $LABEL but $URL is still answering — check 'lsof -nP -iTCP:$PORT'" 2
fi

if [[ "$ACTION" == "status" ]]; then
  PID="$(job_pid)"
  if serving_this_slug; then
    echo "stu: $SLUG running — $URL (launchd $LABEL${PID:+, pid $PID}, log $LOG)"
    exit 0
  fi
  if [[ -n "$PID" ]]; then
    echo "stu: $SLUG loaded as $LABEL (pid $PID) but $URL is not answering yet — log $LOG"
    exit 0
  fi
  echo "stu: $SLUG not running"
  exit 0
fi

# -------------------------------------------------------------------- preflight

[[ -d "$APP/server" ]] || die "no Stu app at $APP
  That path is baked in by bootstrap-nest.mjs from the checkout it ran in. If you moved or
  renamed the clone, re-run 'node scripts/bootstrap-nest.mjs' from it; to use a different
  checkout, set STU_APP to its buzz-agents/agents/stu/app directory."

# Resolved before the key rather than after it, because reading the MCP registry below needs it.
# launchd hands the job a bare PATH, so the interpreter is resolved here, while we still have the
# launching shell's environment, and passed through the plist.
NODE_BIN="${STU_NODE:-$(command -v node || true)}"
[[ -n "$NODE_BIN" && -x "$NODE_BIN" ]] || die "no usable node found — set STU_NODE to its absolute path"

# The service account, resolved the same way as the dataset and for the same reason: a Google
# service account cannot be renamed, so a slug shortened after the account was created leaves the
# two apart forever, and --sa-slug was the caller's job to remember. The deploy already recorded
# the real path — it registered this channel's MCP servers with GOOGLE_APPLICATION_CREDENTIALS
# pointing at the key — so the launcher reads it instead of being told.
#
# Stu's own fenced registry is tried first. It holds exactly one server, for one channel, so
# there is no way to pick up another client's key from it; the user-scope registry is the
# fallback for a machine deployed before the per-agent fences existed, and there the server name
# is matched exactly rather than by prefix, or slug "acme" would match "acme-eu"'s server.
#
# Unlike the dataset, an unreadable registry here is NOT worth refusing over. A wrong or missing
# key fails loudly on its own — the file is either absent, in which case the preflight below says
# so, or it belongs to another client, in which case IAM refuses every query. There is no silent
# wrong answer to protect against, so this narrows to a quiet fallback where the dataset lookup
# has to shout.
KEY="$KEY_ARG"
KEY_FROM=""
if [[ -z "$KEY_ARG" && -z "$SA_SLUG_GIVEN" ]]; then
  KEY_RESOLVED="$("$NODE_BIN" -e '
    const fs = require("node:fs");
    const [slug, ...files] = process.argv.slice(1);
    for (const file of files) {
      let servers;
      try { servers = JSON.parse(fs.readFileSync(file, "utf8")).mcpServers; } catch { continue; }
      if (!servers) continue;
      for (const name of [`bq-${slug}-explore`, `bq-${slug}`, `bq-${slug}-ro`]) {
        const key = servers[name]?.env?.GOOGLE_APPLICATION_CREDENTIALS;
        if (key && fs.existsSync(key)) { process.stdout.write(`${key}\n${file}`); process.exit(0); }
      }
    }
  ' "$SLUG" \
    "$BUZZ_HOME/proxy/claude-config-stu-$SLUG/.claude.json" \
    "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" 2>/dev/null || true)"
  if [[ -n "$KEY_RESOLVED" ]]; then
    KEY="$(head -1 <<<"$KEY_RESOLVED")"
    KEY_FROM="$(tail -1 <<<"$KEY_RESOLVED")"
  fi
fi

# The derivation stays the default, so a machine with no registry entry behaves as it always has.
KEY="${KEY:-$BUZZ_HOME/.secrets/claire-$SA_SLUG-service-user.json}"
[[ -f "$KEY" ]] || die "no service-account key at $KEY — deploy the channel first
  If this client's service account is not named after its slug, pass --sa-slug <name>
  (or set STU_SA_SLUG). A symlink at the slug-named path works too."
[[ -z "$KEY_FROM" ]] || echo "stu: key $KEY (from ${KEY_FROM/#$HOME/~})"

# server/config.mjs requires a project and deliberately has no default, so leaving this to the
# caller made the documented launch line fail on a clean machine. The key we just preflighted
# names its own project, so read it from there rather than asking a person to know it. An
# explicit --project or STU_PROJECT still wins, for the case where they differ on purpose.
if [[ -z "$PROJECT" ]]; then
  PROJECT="$("$NODE_BIN" -e '
    const fs = require("node:fs");
    try { process.stdout.write(JSON.parse(fs.readFileSync(process.argv[1], "utf8")).project_id ?? ""); }
    catch { process.exit(1); }
  ' "$KEY" 2>/dev/null || true)"
  [[ -n "$PROJECT" ]] || die "could not read project_id from $KEY — pass --project <id> or set STU_PROJECT"
fi

# Same move for the dataset, and for the same reason: the name is already written down on this
# machine, so asking a caller to repeat it correctly is a step that can only be got wrong. The
# channel's fenced MCP server is the copy to read — deploy-claire-channel.sh renders it from the
# --dataset the dataset was created with, and it is the name every agent on this channel already
# queries through, so Stu and the agents cannot end up disagreeing about where the data is.
#
# Not the key file: unlike project_id, a dataset name is nowhere in it. Not the channel canvas
# either, though it records the same value — reading it needs a relay credential, and the launchd
# job that re-enters this script under --supervise has none.
#
# An explicit --dataset or STU_DATASET still wins, and a channel with no MCP server on this
# machine still falls through to the app's research_<slug> derivation, so nothing that worked
# before this stops working.
MCP_YAML="$BUZZ_HOME/mcp/bq-$SLUG.yaml"
# A fence line rather than the file: a bq-<slug>.yaml with no allowedDatasets at all is not this
# script's problem to report, and it leaves the derivation as the answer exactly as before.
if [[ -z "$DATASET" ]] && grep -qE '^[[:space:]]*allowedDatasets:' "$MCP_YAML" 2>/dev/null; then
  # Every item under the fence, space separated. Deliberately captures any list item shape and
  # leaves judging it to the charset check below, rather than matching only well-formed names:
  # a pattern that skips what it cannot parse resolves nothing, falls back to the derivation and
  # launches on the wrong dataset silently, which is the entire failure being removed here. So
  # anything unreadable has to come out of awk looking wrong, not looking absent.
  #
  # `exit` still runs END, which is what stops a second allowedDatasets block further down the
  # file from contributing.
  FENCED="$(awk '
    /^[[:space:]]*allowedDatasets:[[:space:]]*$/ { inlist = 1; next }
    inlist && /^[[:space:]]*#/                   { next }
    inlist && /^[[:space:]]*-/ {
      sub(/^[[:space:]]*-[[:space:]]*/, "")
      sub(/[[:space:]]*#.*$/, "")
      sub(/[[:space:]]+$/, "")
      if ($0 != "") names = (names == "" ? $0 : names " " $0)
      next
    }
    inlist && /[^[:space:]]/ { exit }
    END { print names }
  ' "$MCP_YAML")"
  # Quotes are stripped here rather than in awk, where escaping them into a single-quoted program
  # costs more than it buys. A YAML list of one plain scalar is what the template writes; a quoted
  # one is still legal and still means the same dataset.
  FENCED="${FENCED//\"/}"
  FENCED="${FENCED//\'/}"
  read -ra FENCED_LIST <<<"$FENCED"

  # Three ways this can fail, and all three are louder than resolving nothing. Flow style
  # (`allowedDatasets: [x]`) lands on the first: the block regex above needs the key alone on its
  # line, so the grep sees a fence that awk reports as empty.
  [[ "${#FENCED_LIST[@]}" -ge 1 ]] || die "$MCP_YAML has an allowedDatasets fence this script
  could not read, so the dataset it names is unknown. Pass --dataset <name>."
  [[ "${#FENCED_LIST[@]}" -le 1 ]] || die "$MCP_YAML fences ${#FENCED_LIST[@]} datasets, so which
  one Stu should open is not implied. Pass --dataset <name> to say which."
  [[ "${FENCED_LIST[0]}" =~ ^[A-Za-z0-9_]+$ ]] || die "$MCP_YAML fences a name that BigQuery
  cannot hold, so nothing would answer on it. Fix the fence, or pass --dataset <name>."

  DATASET="${FENCED_LIST[0]}"
  echo "stu: dataset $DATASET (from mcp/bq-$SLUG.yaml)"
fi

# Deliberately stricter than the app, which also accepts an email as an identity. On this path a
# pubkey always exists — an agent has the sender's, and it is better than an email because it
# survives a rename — so anything else in --user is a mistake worth catching at the launcher
# rather than recording in edit_log. Someone with only an email uses --user-email; the app takes
# that as the identity on its own. See app/server/actor.mjs.
if [[ -n "$USER_PUBKEY" && ! "$USER_PUBKEY" =~ ^[0-9a-f]{64}$ ]]; then
  die "--user must be a 64-character hex pubkey (not an npub): got \"$USER_PUBKEY\"
  If you only have an email address, pass --user-email <you@company.com> and leave --user off."
fi

ARGS=(--slug "$SLUG" --project "$PROJECT" --port "$PORT")
# The path the preflight above just proved exists, rather than letting config.mjs derive its own
# from the slug. Two derivations meant --sa-slug got as far as the launcher and no further: the
# server went looking under the slug-named path and exited "service-account key not found" while
# the launcher had already found the key under the name it was told.
ARGS+=(--key "$KEY")
[[ -n "$DATASET" ]]     && ARGS+=(--dataset "$DATASET")
[[ -n "$CHANNEL" ]]     && ARGS+=(--channel "$CHANNEL")
[[ -n "$USER_PUBKEY" ]] && ARGS+=(--user "$USER_PUBKEY")
[[ -n "$USER_NAME" ]]   && ARGS+=(--user-name "$USER_NAME")
[[ -n "$USER_EMAIL" ]]  && ARGS+=(--user-email "$USER_EMAIL")

# -------------------------------------------------------------------- supervise (launchd child)

if [[ "$ACTION" == "supervise" ]]; then
  echo "stu: supervising $SLUG on $PORT (node $NODE_BIN)"

  "$NODE_BIN" "$APP/server/server.mjs" "${ARGS[@]}" &
  CHILD=$!

  # launchctl bootout / kickstart -k sends SIGTERM here; take node down with us.
  trap 'kill "$CHILD" 2>/dev/null || true; wait "$CHILD" 2>/dev/null || true; exit 0' TERM INT

  # Only couple our lifetime to Buzz if Buzz was up when we started. Started from a plain terminal
  # with the app closed, Stu should keep running until it is told to stop.
  BUZZ_PID="$(buzz_desktop_pid)"
  [[ -n "$BUZZ_PID" ]] \
    && echo "stu: tracking Buzz Desktop (pid $BUZZ_PID) — will shut down when it quits" \
    || echo "stu: Buzz Desktop is not running — staying up until --stop"

  while :; do
    if ! kill -0 "$CHILD" 2>/dev/null; then
      RC=0; wait "$CHILD" 2>/dev/null || RC=$?
      # Nonzero exit is what KeepAlive/SuccessfulExit=false reacts to, so a crashed server comes
      # back instead of leaving a dead URL behind.
      echo "stu: server exited (rc $RC) — launchd will restart it" >&2
      exit 1
    fi
    if [[ -n "$BUZZ_PID" ]] && ! kill -0 "$BUZZ_PID" 2>/dev/null; then
      echo "stu: Buzz Desktop closed — shutting down $SLUG"
      kill "$CHILD" 2>/dev/null || true
      wait "$CHILD" 2>/dev/null || true
      exit 0
    fi
    sleep 2
  done
fi

# -------------------------------------------------------------------- build

# The server serves web/dist. A missing build is the most common first-run failure, so build it
# rather than handing back a 404 the user has to interpret.
if [[ ! -f "$APP/web/dist/index.html" ]]; then
  echo "stu: no web build found — building (first run only)"
  ( cd "$APP/web" && npm install --silent && npm run build --silent ) \
    || die "the web build failed" 2
fi

if [[ "$ACTION" == "foreground" ]]; then
  exec "$NODE_BIN" "$APP/server/server.mjs" "${ARGS[@]}"
fi

# -------------------------------------------------------------------- start under launchd

if serving_this_slug; then
  if serving_this_dataset; then
    echo "stu: already running — $URL"
    exit 0
  fi
  die "$SLUG is already running on port $PORT out of a different dataset than this launch resolved
  ($DATASET):
  $(curl -fsS --max-time 2 "$URL/api/config" 2>/dev/null)
  Restarting it would drop whoever is using it, so this is not done for you. Run
  '$SELF --slug $SLUG --stop' and launch again, or pass --port to run the other one beside it." 2
fi
if RUNNING="$(curl -fsS --max-time 2 "$URL/api/config" 2>/dev/null)"; then
  die "port $PORT is serving a different channel: $RUNNING
  Pass --port to run this one alongside it." 2
fi

mkdir -p "$RUN_DIR"

xml_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' <<<"$1"; }
plist_arg() { printf '    <string>%s</string>\n' "$(xml_escape "$1")"; }

{
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(xml_escape "$LABEL")</string>
  <key>ProgramArguments</key>
  <array>
EOF
  plist_arg "$SELF"
  plist_arg "--supervise"
  plist_arg "--slug"; plist_arg "$SLUG"
  # The resolved key, not the --sa-slug that may have produced it. The child runs this same script
  # and redoes the whole preflight, so anything the parent worked out has to reach it as the answer
  # rather than as the question. This line has produced the same failure twice. Once in the repo:
  # --sa-slug was absent here, so the parent found the key, the child looked under the slug-named
  # path and died "no service-account key ... deploy the channel first" from a correctly deployed
  # channel. Once while the lookup above was being written: --sa-slug had since been added, and the
  # child, seeing a flag, skipped the lookup that had just succeeded in the parent and died the same
  # way. Both only appeared to work where a symlink happened to sit at the slug-named path, which is
  # what made the first one survive as long as it did. Passing the path ends the class.
  plist_arg "--key"; plist_arg "$KEY"
  plist_arg "--project"; plist_arg "$PROJECT"
  plist_arg "--port"; plist_arg "$PORT"
  if [[ -n "$DATASET" ]];     then plist_arg "--dataset";    plist_arg "$DATASET"; fi
  if [[ -n "$CHANNEL" ]];     then plist_arg "--channel";    plist_arg "$CHANNEL"; fi
  if [[ -n "$USER_PUBKEY" ]]; then plist_arg "--user";       plist_arg "$USER_PUBKEY"; fi
  if [[ -n "$USER_NAME" ]];   then plist_arg "--user-name";  plist_arg "$USER_NAME"; fi
  if [[ -n "$USER_EMAIL" ]];  then plist_arg "--user-email"; plist_arg "$USER_EMAIL"; fi
  cat <<EOF
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>$(xml_escape "$HOME")</string>
    <key>BUZZ_HOME</key><string>$(xml_escape "$BUZZ_HOME")</string>
    <key>STU_NODE</key><string>$(xml_escape "$NODE_BIN")</string>
    <key>PATH</key><string>$(xml_escape "$(dirname "$NODE_BIN"):/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin")</string>
  </dict>
  <key>WorkingDirectory</key><string>$(xml_escape "$APP")</string>
  <key>StandardOutPath</key><string>$(xml_escape "$LOG")</string>
  <key>StandardErrorPath</key><string>$(xml_escape "$LOG")</string>
  <key>RunAtLoad</key><true/>
  <!-- Restart a crash, but respect a clean exit: that is how "stopped because Buzz closed" and
       "stopped because someone ran --stop" avoid being undone by the supervisor coming back. -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
EOF
} > "$PLIST"

# A previous run may still be loaded but not listening (crash-throttled, or exited when Buzz
# closed). bootstrap refuses to load a label twice, so clear it first.
launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
launchctl bootstrap "$DOMAIN" "$PLIST" || die "launchd refused to load $LABEL from $PLIST" 2

# Wait for the port rather than sleeping a fixed amount: the first BigQuery token exchange is
# the slow part and it varies.
for _ in $(seq 1 30); do
  # Both, so "ready" means the flag actually reached the server rather than that something
  # answered. A silently ignored --dataset would otherwise look like a clean start.
  if serving_this_slug && serving_this_dataset; then
    echo "stu: $SLUG → $URL (launchd $LABEL, pid $(job_pid), log $LOG)"
    echo "stu: stays up until '$SELF --slug $SLUG --stop' or Buzz Desktop quits"
    exit 0
  fi
  sleep 1
done

# Do not leave a job crash-looping in the background under a name that looks healthy.
tail -40 "$LOG" >&2 2>/dev/null || true
launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
die "the server did not become ready within 30s (log $LOG)" 2
