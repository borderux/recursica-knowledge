{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "60000"
  },
  "permissions": {
    "allow": [
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-published-text.mjs",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-commit-trailers.mjs",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking the commit for the operator's sign-off"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-published-text.mjs",
            "if": "Bash(gh *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-published-text.mjs",
            "if": "Bash(buzz *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-published-text.mjs",
            "if": "Bash(curl *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-stale-checkout.mjs",
            "timeout": 20,
            "statusMessage": "Checking the checkout is a repository"
          },
          {
            "$comment": "No `if` key, deliberately. Every entry above has one, and on 2026-08-12 `Bash(git *)` denied a command with git not leading while `Bash(curl *)` failed to deny one with curl leading — verified independently by two agents, explained by neither. This guard is registered the way the one hook that fires reliably is registered, and does its own per-segment command test in guard-credential-store.mjs, which has tests. `security` also has too many spellings for a leading-command glob: /usr/bin/security, `FOO=1 security`, `sudo security`, `cd … && security`.",
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-credential-store.mjs",
            "timeout": 20,
            "statusMessage": "Checking for credential-store enumeration"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-stale-checkout.mjs",
            "timeout": 20,
            "statusMessage": "Checking the checkout is a repository"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-credential-store.mjs",
            "timeout": 20,
            "statusMessage": "Checking for credential-store enumeration"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{BUZZ_HOME}}/bin/wake-janice.sh",
            "async": true,
            "timeout": 30,
            "statusMessage": "Waking Janice for review"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/check-agents-md-drift.mjs",
            "timeout": 15,
            "statusMessage": "Checking AGENTS.md for a silent upgrade wipe"
          }
        ]
      }
    ]
  }
}
