{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "60000"
  },
  "permissions": {
    "allow": [
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-published-text.mjs",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-commit-trailers.mjs",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking the commit for the operator's sign-off"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-published-text.mjs",
            "if": "Bash(gh *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-published-text.mjs",
            "if": "Bash(buzz *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-published-text.mjs",
            "if": "Bash(curl *)",
            "timeout": 20,
            "statusMessage": "Checking published text for names"
          },
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-stale-checkout.mjs",
            "timeout": 20,
            "statusMessage": "Checking the checkout is a repository"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node {{BUZZ_HOME}}/bin/guard-stale-checkout.mjs",
            "timeout": 20,
            "statusMessage": "Checking the checkout is a repository"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{BUZZ_HOME}}/bin/wake-janice.sh",
            "async": true,
            "timeout": 30,
            "statusMessage": "Waking Janice for review"
          }
        ]
      }
    ]
  }
}
