# READ-ONLY fenced BigQuery MCP server for Buzz channel @SLUG@
# Channel UUID: @CHANNEL_UUID@
# Dataset:      @PROJECT@.@DATASET@
# Generated by deploy-claire-channel.sh — edit the template, not this file.
#
# Hand-authored on purpose. `--prebuilt bigquery` CANNOT express `allowedDatasets`
# (its embedded config substitutes only BIGQUERY_{PROJECT,LOCATION,USE_CLIENT_OAUTH,
# SCOPES,MAX_QUERY_RESULT_ROWS,IMPERSONATE_SERVICE_ACCOUNT,MAXIMUM_BYTES_BILLED}).
# Setting BIGQUERY_ALLOWED_DATASETS with --prebuilt is silently ignored and yields an
# UNFENCED server. The toolbox also warns that --prebuilt is "not secure enough for
# run time" — this file is the run-time answer.
#
# This config is the SECOND line of defence. The first is IAM: the service account
# behind it should hold project-level roles/bigquery.jobUser only, with data access
# granted per-dataset. If IAM is right, a bug in this file cannot leak another
# client's data.

sources:
  bq-channel:
    kind: bigquery
    project: @PROJECT@
    location: US

    # Fence. execute_sql rejects any query touching another dataset, and refuses
    # CREATE/DROP/ALTER SCHEMA entirely while this is set. Dataset must already exist
    # at startup or the server refuses to boot.
    allowedDatasets:
      - @DATASET@

    # Analyst only reads. 'blocked' is what makes its prompt's "you have no write
    # access to any BigQuery table" a fact rather than an instruction the model may
    # ignore. Every other role uses the read-write server.
    writeMode: blocked

    # <= 0 disables the 50-row default cap. The cap is silent — see ingest_runs
    # reconciliation, which is what actually makes a short read visible.
    maxQueryResultRows: -1

    # Cost ceiling: 1 GiB scanned per query. Fails loudly instead of billing.
    maximumBytesBilled: 1073741824

  # Analyst's ONE write path, and it carries no general-purpose SQL tool. The statement in
  # write_finding below is fixed at config time, so `writeMode: allowed` here buys the agent
  # exactly one INSERT into one table — not arbitrary writes. Never attach a
  # bigquery-execute-sql tool to this source; that would undo the whole arrangement.
  bq-channel-findings:
    kind: bigquery
    project: @PROJECT@
    location: US
    allowedDatasets:
      - @DATASET@
    writeMode: allowed
    maxQueryResultRows: -1
    maximumBytesBilled: 1073741824

tools:
  execute_sql:
    kind: bigquery-execute-sql
    source: bq-channel
    description: Run a read-only query against this research channel's dataset. Writes are refused.

  get_table_info:
    kind: bigquery-get-table-info
    source: bq-channel
    description: Get table metadata (schema, row count) within this channel's dataset.

  # Traceability, enforced by the database rather than by the prompt. Three properties the
  # statement guarantees no matter what the model intends:
  #   1. Evidence cannot be empty.
  #   2. Every cited line_id must already exist in transcript_lines — a fabricated citation
  #      raises and writes nothing. This is the anti-hallucination gate.
  #   3. status is hardcoded 'proposed' and reviewed_by/reviewed_at are not parameters, so an
  #      agent cannot approve its own finding. Same gate as project_dictionary.
  write_finding:
    kind: bigquery-sql
    source: bq-channel-findings
    description: |
      Record one research finding with mandatory line-level evidence. Every cited line_id is
      verified against transcript_lines before anything is written: if any line does not exist,
      or evidence is empty, the call fails and no row is created. Findings are always written as
      'proposed' — only a human approves one.
    statement: |
      BEGIN
        DECLARE ev JSON DEFAULT PARSE_JSON(@evidence_json);
        DECLARE bad ARRAY<STRING>;

        IF ARRAY_LENGTH(JSON_QUERY_ARRAY(ev)) = 0 THEN
          RAISE USING MESSAGE =
            'finding rejected: evidence is empty. Every finding must cite transcript lines.';
        END IF;

        SET bad = ARRAY(
          SELECT JSON_VALUE(e, '$.line_id')
          FROM UNNEST(JSON_QUERY_ARRAY(ev)) AS e
          WHERE JSON_VALUE(e, '$.line_id') NOT IN (
            SELECT line_id FROM `@PROJECT@.@DATASET@.transcript_lines`
          )
        );
        IF ARRAY_LENGTH(bad) > 0 THEN
          RAISE USING MESSAGE = FORMAT(
            'finding rejected: line_id(s) not present in transcript_lines: %s',
            ARRAY_TO_STRING(bad, ', '));
        END IF;

        MERGE `@PROJECT@.@DATASET@.findings` T
        USING (SELECT @finding_id AS finding_id) S
        ON T.finding_id = S.finding_id
        WHEN NOT MATCHED THEN INSERT (
          finding_id, project_name, conversation_id, scope, finding_type, title, statement,
          detail, proposed_answer, evidence, tag_ids, participant_ids, confidence, status,
          produced_by, produced_at, document_uri, notes
        ) VALUES (
          @finding_id, @project_name, @conversation_id, @scope, @finding_type, @title,
          @statement, @detail, @proposed_answer,
          ARRAY(
            SELECT AS STRUCT
              JSON_VALUE(e, '$.conversation_id') AS conversation_id,
              JSON_VALUE(e, '$.line_id')         AS line_id,
              JSON_VALUE(e, '$.quote')           AS quote
            FROM UNNEST(JSON_QUERY_ARRAY(ev)) AS e
          ),
          @tag_ids, @participant_ids, @confidence, 'proposed', @produced_by,
          CURRENT_TIMESTAMP(), @document_uri, @notes
        )
        -- resolution is deliberately absent from this list and must stay absent: it holds a
        -- human's answer to an open question, and a re-analysis re-running with the same
        -- finding_id would erase it. Same rule as line_edits — see the schema guide, "An open
        -- question is a finding, not a second table".
        WHEN MATCHED THEN UPDATE SET
          project_name = @project_name, conversation_id = @conversation_id, scope = @scope,
          finding_type = @finding_type, title = @title, statement = @statement,
          detail = @detail, proposed_answer = @proposed_answer,
          evidence = ARRAY(
            SELECT AS STRUCT
              JSON_VALUE(e, '$.conversation_id') AS conversation_id,
              JSON_VALUE(e, '$.line_id')         AS line_id,
              JSON_VALUE(e, '$.quote')           AS quote
            FROM UNNEST(JSON_QUERY_ARRAY(ev)) AS e
          ),
          tag_ids = @tag_ids, participant_ids = @participant_ids, confidence = @confidence,
          produced_by = @produced_by, produced_at = CURRENT_TIMESTAMP(),
          document_uri = @document_uri, notes = @notes;
      END;
    parameters:
      - name: finding_id
        type: string
        description: Stable id. Re-running with the same id updates that finding rather than duplicating it.
      - name: project_name
        type: string
        description: Project this finding belongs to.
      - name: conversation_id
        type: string
        description: The interview this finding came from. Empty string for a cross-interview finding.
      - name: scope
        type: string
        description: interview | cohort | project
      - name: finding_type
        type: string
        description: |
          theme | sentiment | pain_point | need | behaviour | quote | opportunity | open_question | hypothesis
          Use open_question when the transcript does not settle something and saying so is the
          useful output. Use hypothesis when you are offering a claim you do not think the evidence
          carries yet — a pattern worth testing, not a finding. The two are different: a question is
          "I cannot tell", a hypothesis is "I think this, weakly".
          Never encode the kind in the title. `OPEN QUESTION:` and `HYPOTHESIS:` prefixes put the
          one fact a reviewer routes on into prose, where nothing can filter, count or group by it.
          The type column is the only place the kind belongs.
      - name: title
        type: string
        description: Short label for the finding.
      - name: statement
        type: string
        description: The claim itself, in one or two sentences.
      - name: detail
        type: string
        description: Supporting explanation. May be empty.
      - name: proposed_answer
        type: string
        description: |
          open_question only: the answer you would assume if nobody rules, so a reviewer can
          confirm it in one move. Leave empty when the transcript genuinely does not support one —
          an unresolvable question should carry no assumption. Never an approval: only a human
          writes the answer of record, and they write it through Stu.
      - name: evidence_json
        type: string
        description: |
          JSON array, one object per citation:
          [{"conversation_id":"c_…","line_id":"c_…:12","quote":"what they actually said"}]
          Must be non-empty and every line_id must exist. Quote the line verbatim.
      - name: tag_ids
        type: array
        description: Tag ids this finding rests on.
        items:
          name: tag_id
          type: string
          description: A tag id from tag_library.
      - name: participant_ids
        type: array
        description: Participants this finding is about.
        items:
          name: participant_id
          type: string
          description: A participant_id.
      - name: confidence
        type: float
        description: 0-1. How well the evidence supports the claim.
      - name: produced_by
        type: string
        description: Agent identity and prompt version that produced this.
      - name: document_uri
        type: string
        description: Drive URL of the write-up rendered from these findings. May be empty.
      - name: notes
        type: string
        description: Anything a reviewer should know. May be empty.

  # Percy's ONE write path, same architecture as write_finding above and for the same reason:
  # a fixed statement on a source with no general-purpose SQL tool attached, so writeMode: allowed
  # buys exactly this — never arbitrary writes. Unlike write_finding, this statement also owns
  # version allocation and superseding: an agent supplies content, never a version number.
  write_persona_set:
    kind: bigquery-sql
    source: bq-channel-findings
    description: |
      Write one persona-set version for a population. The tool — not the caller — allocates the
      version number, flips whatever version was previously current for this population to
      superseded in the same transaction, and refuses to write if the incoming personas are
      unchanged from that population's latest version. Always written as 'draft': only a human,
      through Stu, promotes a version to 'current'.
    statement: |
      BEGIN
        DECLARE ev JSON DEFAULT PARSE_JSON(@evidence_json);
        DECLARE bad ARRAY<STRING>;
        DECLARE cur_version INT64;
        DECLARE cur_personas JSON;
        DECLARE new_version INT64;

        IF ARRAY_LENGTH(JSON_QUERY_ARRAY(ev)) = 0 THEN
          RAISE USING MESSAGE =
            'persona set rejected: evidence is empty. Every version must cite transcript lines.';
        END IF;

        SET bad = ARRAY(
          SELECT JSON_VALUE(e, '$.line_id')
          FROM UNNEST(JSON_QUERY_ARRAY(ev)) AS e
          WHERE JSON_VALUE(e, '$.line_id') NOT IN (
            SELECT line_id FROM `@PROJECT@.@DATASET@.transcript_lines`
          )
        );
        IF ARRAY_LENGTH(bad) > 0 THEN
          RAISE USING MESSAGE = FORMAT(
            'persona set rejected: line_id(s) not present in transcript_lines: %s',
            ARRAY_TO_STRING(bad, ', '));
        END IF;

        -- The population's latest non-superseded row, if one exists. Two separate scalar
        -- subqueries rather than one tuple assignment: each returns NULL on zero rows (a
        -- population's first version) rather than erroring, which a tuple form would not do
        -- as simply.
        SET cur_version = (
          SELECT version FROM `@PROJECT@.@DATASET@.persona_sets`
          WHERE population_id = @population_id AND status != 'superseded'
          ORDER BY version DESC LIMIT 1
        );
        SET cur_personas = (
          SELECT personas FROM `@PROJECT@.@DATASET@.persona_sets`
          WHERE population_id = @population_id AND status != 'superseded'
          ORDER BY version DESC LIMIT 1
        );
        SET new_version = COALESCE(cur_version, 0) + 1;

        IF cur_personas IS NOT NULL
           AND TO_JSON_STRING(PARSE_JSON(@personas_json)) = TO_JSON_STRING(cur_personas) THEN
          RAISE USING MESSAGE = FORMAT(
            'persona set rejected: no change from version %d for population %s. A re-run that changed nothing is not a new version.',
            cur_version, @population_id);
        END IF;

        IF cur_version IS NOT NULL THEN
          UPDATE `@PROJECT@.@DATASET@.persona_sets`
          SET status = 'superseded'
          WHERE population_id = @population_id AND version = cur_version;
        END IF;

        INSERT INTO `@PROJECT@.@DATASET@.persona_sets` (
          population_id, version, status, supersedes, goals_available, run_summary,
          cohort_alignment, personas, evidence, diff, produced_by, produced_at, document_uri, notes
        ) VALUES (
          @population_id, new_version, 'draft', cur_version, @goals_available,
          PARSE_JSON(@run_summary_json), PARSE_JSON(@cohort_alignment_json),
          PARSE_JSON(@personas_json),
          ARRAY(
            SELECT AS STRUCT
              JSON_VALUE(e, '$.conversation_id') AS conversation_id,
              JSON_VALUE(e, '$.line_id')         AS line_id,
              JSON_VALUE(e, '$.quote')           AS quote
            FROM UNNEST(JSON_QUERY_ARRAY(ev)) AS e
          ),
          PARSE_JSON(@diff_json), @produced_by, CURRENT_TIMESTAMP(), @document_uri, @notes
        );
      END;
    parameters:
      - name: population_id
        type: string
        description: A lookup-resolved population id. Never a raw cohort value — Percy never has a raw one to pass.
      - name: goals_available
        type: boolean
        description: FALSE when this version was clustered with no research-goals input.
      - name: run_summary_json
        type: string
        description: |
          JSON object: {"interviews":N,"total_participants":N,"placed":N,"singletons":["P-07"],"cluster_count":N}
      - name: cohort_alignment_json
        type: string
        description: |
          JSON: Pass 1's self-report of whether emergent clusters line up with, cut across, or
          show no relation to the raw cohort value(s) underneath this population.
      - name: personas_json
        type: string
        description: |
          JSON array of persona objects — the archetypes themselves. Shape is documented in
          persona.md.tmpl, not enforced by this statement beyond being valid JSON.
      - name: evidence_json
        type: string
        description: |
          JSON array, one object per citation, flattened and deduped across every persona in this
          version: [{"conversation_id":"c_…","line_id":"c_…:12","quote":"what they actually said"}]
          Must be non-empty and every line_id must exist. Quote the line verbatim.
      - name: diff_json
        type: string
        description: |
          JSON object — new / changed / dissolved personas and participants who moved clusters,
          versus the version this one supersedes. Pass the literal string "null" for a
          population's first version.
      - name: produced_by
        type: string
        description: Agent identity and prompt version that produced this.
      - name: document_uri
        type: string
        description: Drive URL of the write-up rendered from this version. May be empty.
      - name: notes
        type: string
        description: Anything a reviewer should know. May be empty.

# Deliberately omitted:
#   list_dataset_ids, search_catalog  — project-wide surface; a fenced server should
#                                       not help an agent discover other channels.
#   ask_data_insights, forecast,
#   analyze_contribution              — not used by the pipeline; each is extra
#                                       attack surface and extra spend.

toolsets:
  claire-channel-ro:
    - execute_sql
    - get_table_info
    - write_finding
    - write_persona_set
