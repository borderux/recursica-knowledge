# READ-ONLY fenced BigQuery MCP server for Buzz channel @SLUG@
# Channel UUID: @CHANNEL_UUID@
# Dataset:      @PROJECT@.@DATASET@
# Generated by deploy-claire-channel.sh — edit the template, not this file.
#
# Hand-authored on purpose. `--prebuilt bigquery` CANNOT express `allowedDatasets`
# (its embedded config substitutes only BIGQUERY_{PROJECT,LOCATION,USE_CLIENT_OAUTH,
# SCOPES,MAX_QUERY_RESULT_ROWS,IMPERSONATE_SERVICE_ACCOUNT,MAXIMUM_BYTES_BILLED}).
# Setting BIGQUERY_ALLOWED_DATASETS with --prebuilt is silently ignored and yields an
# UNFENCED server. The toolbox also warns that --prebuilt is "not secure enough for
# run time" — this file is the run-time answer.
#
# This config is the SECOND line of defence. The first is IAM: the service account
# behind it should hold project-level roles/bigquery.jobUser only, with data access
# granted per-dataset. If IAM is right, a bug in this file cannot leak another
# client's data.

sources:
  bq-channel:
    kind: bigquery
    project: @PROJECT@
    location: US

    # Fence. execute_sql rejects any query touching another dataset, and refuses
    # CREATE/DROP/ALTER SCHEMA entirely while this is set. Dataset must already exist
    # at startup or the server refuses to boot.
    allowedDatasets:
      - @DATASET@

    # Analyst only reads. 'blocked' is what makes its prompt's "you have no write
    # access to any BigQuery table" a fact rather than an instruction the model may
    # ignore. Every other role uses the read-write server.
    writeMode: blocked

    # <= 0 disables the 50-row default cap. The cap is silent — see ingest_runs
    # reconciliation, which is what actually makes a short read visible.
    maxQueryResultRows: -1

    # Cost ceiling: 1 GiB scanned per query. Fails loudly instead of billing.
    maximumBytesBilled: 1073741824

  # Analyst's ONE write path, and it carries no general-purpose SQL tool. The statement in
  # write_finding below is fixed at config time, so `writeMode: allowed` here buys the agent
  # exactly one INSERT into one table — not arbitrary writes. Never attach a
  # bigquery-execute-sql tool to this source; that would undo the whole arrangement.
  bq-channel-findings:
    kind: bigquery
    project: @PROJECT@
    location: US
    allowedDatasets:
      - @DATASET@
    writeMode: allowed
    maxQueryResultRows: -1
    maximumBytesBilled: 1073741824

tools:
  execute_sql:
    kind: bigquery-execute-sql
    source: bq-channel
    description: Run a read-only query against this research channel's dataset. Writes are refused.

  get_table_info:
    kind: bigquery-get-table-info
    source: bq-channel
    description: Get table metadata (schema, row count) within this channel's dataset.

  # Traceability, enforced by the database rather than by the prompt. Three properties the
  # statement guarantees no matter what the model intends:
  #   1. Evidence cannot be empty.
  #   2. Every cited line_id must already exist in transcript_lines — a fabricated citation
  #      raises and writes nothing. This is the anti-hallucination gate.
  #   3. status is hardcoded 'proposed' and reviewed_by/reviewed_at are not parameters, so an
  #      agent cannot approve its own finding. Same gate as project_dictionary.
  write_finding:
    kind: bigquery-sql
    source: bq-channel-findings
    description: |
      Record one research finding with mandatory line-level evidence. Every cited line_id is
      verified against transcript_lines before anything is written: if any line does not exist,
      or evidence is empty, the call fails and no row is created. Findings are always written as
      'proposed' — only a human approves one.
    statement: |
      BEGIN
        DECLARE ev JSON DEFAULT PARSE_JSON(@evidence_json);
        DECLARE bad ARRAY<STRING>;

        IF ARRAY_LENGTH(JSON_QUERY_ARRAY(ev)) = 0 THEN
          RAISE USING MESSAGE =
            'finding rejected: evidence is empty. Every finding must cite transcript lines.';
        END IF;

        SET bad = ARRAY(
          SELECT JSON_VALUE(e, '$.line_id')
          FROM UNNEST(JSON_QUERY_ARRAY(ev)) AS e
          WHERE JSON_VALUE(e, '$.line_id') NOT IN (
            SELECT line_id FROM `@PROJECT@.@DATASET@.transcript_lines`
          )
        );
        IF ARRAY_LENGTH(bad) > 0 THEN
          RAISE USING MESSAGE = FORMAT(
            'finding rejected: line_id(s) not present in transcript_lines: %s',
            ARRAY_TO_STRING(bad, ', '));
        END IF;

        MERGE `@PROJECT@.@DATASET@.findings` T
        USING (SELECT @finding_id AS finding_id) S
        ON T.finding_id = S.finding_id
        WHEN NOT MATCHED THEN INSERT (
          finding_id, project_name, conversation_id, scope, finding_type, title, statement,
          detail, evidence, tag_ids, participant_ids, confidence, status, produced_by,
          produced_at, document_uri, notes
        ) VALUES (
          @finding_id, @project_name, @conversation_id, @scope, @finding_type, @title,
          @statement, @detail,
          ARRAY(
            SELECT AS STRUCT
              JSON_VALUE(e, '$.conversation_id') AS conversation_id,
              JSON_VALUE(e, '$.line_id')         AS line_id,
              JSON_VALUE(e, '$.quote')           AS quote
            FROM UNNEST(JSON_QUERY_ARRAY(ev)) AS e
          ),
          @tag_ids, @participant_ids, @confidence, 'proposed', @produced_by,
          CURRENT_TIMESTAMP(), @document_uri, @notes
        )
        WHEN MATCHED THEN UPDATE SET
          project_name = @project_name, conversation_id = @conversation_id, scope = @scope,
          finding_type = @finding_type, title = @title, statement = @statement,
          detail = @detail,
          evidence = ARRAY(
            SELECT AS STRUCT
              JSON_VALUE(e, '$.conversation_id') AS conversation_id,
              JSON_VALUE(e, '$.line_id')         AS line_id,
              JSON_VALUE(e, '$.quote')           AS quote
            FROM UNNEST(JSON_QUERY_ARRAY(ev)) AS e
          ),
          tag_ids = @tag_ids, participant_ids = @participant_ids, confidence = @confidence,
          produced_by = @produced_by, produced_at = CURRENT_TIMESTAMP(),
          document_uri = @document_uri, notes = @notes;
      END;
    parameters:
      - name: finding_id
        type: string
        description: Stable id. Re-running with the same id updates that finding rather than duplicating it.
      - name: project_name
        type: string
        description: Project this finding belongs to.
      - name: conversation_id
        type: string
        description: The interview this finding came from. Empty string for a cross-interview finding.
      - name: scope
        type: string
        description: interview | cohort | project
      - name: finding_type
        type: string
        description: theme | sentiment | pain_point | need | behaviour | quote | opportunity
      - name: title
        type: string
        description: Short label for the finding.
      - name: statement
        type: string
        description: The claim itself, in one or two sentences.
      - name: detail
        type: string
        description: Supporting explanation. May be empty.
      - name: evidence_json
        type: string
        description: |
          JSON array, one object per citation:
          [{"conversation_id":"c_…","line_id":"c_…:12","quote":"what they actually said"}]
          Must be non-empty and every line_id must exist. Quote the line verbatim.
      - name: tag_ids
        type: array
        description: Tag ids this finding rests on.
        items:
          name: tag_id
          type: string
          description: A tag id from tag_library.
      - name: participant_ids
        type: array
        description: Participants this finding is about.
        items:
          name: participant_id
          type: string
          description: A participant_id.
      - name: confidence
        type: float
        description: 0-1. How well the evidence supports the claim.
      - name: produced_by
        type: string
        description: Agent identity and prompt version that produced this.
      - name: document_uri
        type: string
        description: Drive URL of the write-up rendered from these findings. May be empty.
      - name: notes
        type: string
        description: Anything a reviewer should know. May be empty.

# Deliberately omitted:
#   list_dataset_ids, search_catalog  — project-wide surface; a fenced server should
#                                       not help an agent discover other channels.
#   ask_data_insights, forecast,
#   analyze_contribution              — not used by the pipeline; each is extra
#                                       attack surface and extra spend.

toolsets:
  claire-channel-ro:
    - execute_sql
    - get_table_info
    - write_finding
