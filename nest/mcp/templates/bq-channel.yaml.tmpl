# Fenced BigQuery MCP server for Buzz channel @SLUG@
# Channel UUID: @CHANNEL_UUID@
# Dataset:      @PROJECT@.@DATASET@
# Generated by deploy-claire-channel.sh — edit the template, not this file.
#
# Hand-authored on purpose. `--prebuilt bigquery` CANNOT express `allowedDatasets`
# (its embedded config substitutes only BIGQUERY_{PROJECT,LOCATION,USE_CLIENT_OAUTH,
# SCOPES,MAX_QUERY_RESULT_ROWS,IMPERSONATE_SERVICE_ACCOUNT,MAXIMUM_BYTES_BILLED}).
# Setting BIGQUERY_ALLOWED_DATASETS with --prebuilt is silently ignored and yields an
# UNFENCED server. The toolbox also warns that --prebuilt is "not secure enough for
# run time" — this file is the run-time answer.
#
# This config is the SECOND line of defence. The first is IAM: the service account
# behind it should hold project-level roles/bigquery.jobUser only, with data access
# granted per-dataset. If IAM is right, a bug in this file cannot leak another
# client's data.

sources:
  bq-channel:
    kind: bigquery
    project: @PROJECT@
    location: US

    # Fence. execute_sql rejects any query touching another dataset, and refuses
    # CREATE/DROP/ALTER SCHEMA entirely while this is set. Dataset must already exist
    # at startup or the server refuses to boot.
    allowedDatasets:
      - @DATASET@

    # Agents write rows (transcript_lines, tags, project_dictionary, ingest_runs).
    # Set to 'blocked' for a read-only analyst server.
    writeMode: allowed

    # <= 0 disables the 50-row default cap. The cap is silent — see ingest_runs
    # reconciliation, which is what actually makes a short read visible.
    maxQueryResultRows: -1

    # Cost ceiling: 1 GiB scanned per query. Fails loudly instead of billing.
    maximumBytesBilled: 1073741824

tools:
  execute_sql:
    kind: bigquery-execute-sql
    source: bq-channel
    description: Execute SQL against this research channel's dataset only.

  get_dataset_info:
    kind: bigquery-get-dataset-info
    source: bq-channel
    description: Get metadata for this research channel's dataset.

  get_table_info:
    kind: bigquery-get-table-info
    source: bq-channel
    description: Get table metadata (schema, row count) within this channel's dataset.

  list_table_ids:
    kind: bigquery-list-table-ids
    source: bq-channel
    description: List tables in this research channel's dataset.

# Deliberately omitted:
#   list_dataset_ids, search_catalog  — project-wide surface; a fenced server should
#                                       not help an agent discover other channels.
#   ask_data_insights, forecast,
#   analyze_contribution              — not used by the pipeline; each is extra
#                                       attack surface and extra spend.

toolsets:
  claire-channel:
    - execute_sql
    - get_dataset_info
    - get_table_info
    - list_table_ids
