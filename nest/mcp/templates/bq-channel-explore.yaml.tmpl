# READ-ONLY explorer BigQuery MCP server for Buzz channel @SLUG@
# Channel UUID: @CHANNEL_UUID@
# Dataset:      @PROJECT@.@DATASET@
# Generated by deploy-claire-channel.sh — edit the template, not this file.
#
# Stu's server. The *agent* reports on the data so a person can check it, and must never
# change it or approve anything. Neither of the other two servers fits him:
# bq-@SLUG@ allows arbitrary writes, and bq-@SLUG@-ro still carries write_finding,
# which is Analyst's one write path and not Stu's. This one has no write path at all.
#
# THE EXPLORER APP IS A DIFFERENT PATH AND IS MEANT TO WRITE. That is the whole point of
# it: a person edits, approves and rejects in the app, and each change is recorded against
# their pubkey in edit_log. bin/stu hands the service-account key straight to the app with
# --key and runs it under launchd — it never goes through MCP, so nothing in this file
# reaches it. Verified both directions: the same UPDATE is permitted on the app's path and
# refused on this one.
#
# So do not read this file as evidence that the service account is over-granted, and do not
# trim its dataEditor on the strength of it. The agent's restraint lives here; the person's
# authority lives in the app, and they are deliberately not the same thing.
#
# Same fencing rationale as bq-channel.yaml.tmpl: `--prebuilt bigquery` cannot express
# allowedDatasets and silently yields an UNFENCED server, so this file is hand-authored.
#
# This config is the SECOND line of defence. The first is IAM. Note what IAM does not
# cover: it answers "may this credential read this data", never "should this session be
# touching this client". That second question is answered by which servers a session
# loads — see the per-client fence directories written by deploy-claire-channel.sh.

sources:
  bq-channel:
    kind: bigquery
    project: @PROJECT@
    location: US

    # Fence. execute_sql rejects any query touching another dataset, and refuses
    # CREATE/DROP/ALTER SCHEMA entirely while this is set. Dataset must already exist
    # at startup or the server refuses to boot.
    allowedDatasets:
      - @DATASET@

    # Stu is a reporter, not a writer. 'blocked' refuses every DML/DDL statement at the
    # server, so the fence holds whatever the prompt says and whatever the model tries.
    # A model politely declining a DELETE looks identical to an enforced fence and is
    # not one — this line is what makes it real.
    writeMode: blocked

    # <= 0 disables the 50-row default cap. The cap is silent — see ingest_runs
    # reconciliation, which is what actually makes a short read visible.
    maxQueryResultRows: -1

    # Cost ceiling: 1 GiB scanned per query. Fails loudly instead of billing.
    maximumBytesBilled: 1073741824

tools:
  execute_sql:
    kind: bigquery-execute-sql
    source: bq-channel
    description: Run a read-only query against this research channel's dataset. Writes are refused.

  get_dataset_info:
    kind: bigquery-get-dataset-info
    source: bq-channel
    description: Get metadata for this research channel's dataset.

  get_table_info:
    kind: bigquery-get-table-info
    source: bq-channel
    description: Get table metadata (schema, row count) within this channel's dataset.

  list_table_ids:
    kind: bigquery-list-table-ids
    source: bq-channel
    description: List tables in this research channel's dataset.

# Deliberately omitted:
#   write_finding                     — Analyst's write path, not Stu's. Findings move
#                                       from proposed to active by human hand only.
#   list_dataset_ids, search_catalog  — project-wide surface; a fenced server should
#                                       not help an agent discover other channels.
#   ask_data_insights, forecast,
#   analyze_contribution              — not used by the pipeline; each is extra
#                                       attack surface and extra spend.

toolsets:
  stu-channel-explore:
    - execute_sql
    - get_dataset_info
    - get_table_info
    - list_table_ids
