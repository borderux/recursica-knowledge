# Dependencies
node_modules/

# Debug
npm-debug.log*

# OS Files
.DS_Store

# Build Artifacts
dist/

# Copied into the project root by @recursica/official-release's postinstall. The inventory check
# reads the package's own copy in node_modules; these duplicates belong to the release.
/recursica.json
/recursica_brand.json
/recursica_tokens.json
/recursica_ui-kit.json
/recursica_variables_scoped.css

# Local Agent Skills Symlinks
.agent/skills/
.claude/skills/




# Real identifier values for this installation, and prompts with them filled in.
# The repository stores {{TOKEN}} markers instead — see buzz-agents/README.md.
buzz-agents/local-values.json
buzz-agents/.resolved/

# Real participant names and transcript filenames, derived from the live dataset by
# refresh-local-redactions.mjs. Literal redactions, so committing them would publish
# the very names they exist to remove — the reason they are not in placeholders.json.
buzz-agents/local-redactions.json

# Credentials, belt and braces. Nothing here is supposed to produce these files —
# service-account keys belong in ~/.buzz/.secrets/, outside any checkout — but a
# single committed key is unrecoverable in a public repo, so the patterns stay.
.env
.env.*
!.env.example
secrets/
**/secrets/
*-service-user.json
*-service-account.json
*-reader.json
*-sa.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
gcp-key.json
**/.secrets/
