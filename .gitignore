# Dependencies
node_modules/

# Debug
npm-debug.log*

# OS Files
.DS_Store

# Build Artifacts
dist/

# Local Agent Skills Symlinks
.agent/skills/
.claude/skills/




# Real identifier values for this installation, and prompts with them filled in.
# The repository stores {{TOKEN}} markers instead — see buzz-agents/README.md.
buzz-agents/local-values.json
buzz-agents/.resolved/

# Credentials, belt and braces. Nothing here is supposed to produce these files —
# service-account keys belong in ~/.buzz/.secrets/, outside any checkout — but a
# single committed key is unrecoverable in a public repo, so the patterns stay.
.env
.env.*
!.env.example
secrets/
**/secrets/
*-service-user.json
*-service-account.json
gcp-key.json
**/.secrets/
